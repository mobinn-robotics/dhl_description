<?xml version="1.0"?>
<package format="3">
  <name>dhl_description</name>
  <version>0.1.0</version>
  <description>
    DHL mobile manipulator description: 4-wheel mobile base + 4-DOF torso +
    dual 7-DOF arms + 2 grippers. Self-contained: ships its own meshes and has
    no dependency on the SolidWorks export packages the arms came from.
    Visualization-only model (no inertia / transmission / ros_control).
  </description>
  <maintainer email="tazel7885@mobinn.co.kr">tazel</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rqt_robot_steering</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
